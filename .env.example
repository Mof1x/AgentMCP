# Токен вашего Telegram-бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Ключ к LLM API (OpenAI / OpenRouter / Groq / DeepSeek)
OPENAI_API_KEY=your_api_key_here

# Опционально: базовый URL для сторонних провайдеров
# Для Groq: https://api.groq.com/openai/v1
# Для OpenRouter: https://openrouter.ai/api/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Название модели (например: openai/gpt-oss-120b, gpt-4o-mini, llama-3.3-70b-versatile)
LLM_MODEL=openai/gpt-oss-120b

# Включать ли подробный вывод вызовов инструментов в консоль
DEBUG_TOOL_CALLS=True
